# API
API_PORT=4000

# REAL Solana mainnet WebSocket RPC
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# REAL BNB Smart Chain WebSocket RPC
BNB_WS_URL=wss://bsc-ws-node.nariox.org:443

# PumpPortal read-only stream. subscribeNewToken + subscribeMigration are free;
# token/account trade streams require a PumpPortal API key and are metered.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
PUMPPORTAL_TOKEN_MINTS=
PUMPPORTAL_WALLETS=

# Optional additional BSC contracts/pools to monitor, comma-separated.
BNB_LOG_ADDRESSES=
BNB_LOG_TOPICS=

# Frontend build-time API URL
NEXT_PUBLIC_API_URL=https://liquidity-intelligence-api.onrender.com

# Production policy: read-only real data. No demo/random/paper execution.
EXECUTION_MODE=READ_ONLY
