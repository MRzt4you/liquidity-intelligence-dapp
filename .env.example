# API
API_PORT=4000

# REAL Solana mainnet WebSocket RPC. Replace with your provider endpoint if needed.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# REAL BNB Smart Chain WebSocket RPC. Use a reliable provider endpoint.
BNB_WS_URL=wss://bsc-ws-node.nariox.org:443

# Optional real third-party read-only PumpPortal stream
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Optional BSC log filters (comma-separated)
BNB_LOG_ADDRESSES=
BNB_LOG_TOPICS=

# Frontend build-time API URL. Render blueprint defaults to the API service URL.
NEXT_PUBLIC_API_URL=https://liquidity-intelligence-api.onrender.com

# IMPORTANT: no paper/demo execution variables are used by the production scanner.
# Real-money execution is intentionally NOT enabled by this package.
